{
  "name": "jobs-portal-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "npm run --workspace=@repo/db db:generate",
    "db:migrate": "npm run --workspace=@repo/db db:migrate",
    "db:seed": "npm run --workspace=@repo/db db:seed",
    "db:studio": "npm run --workspace=@repo/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.9.2"
}
