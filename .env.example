# Database (Postgres)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/job_aggregator?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Claude API
ANTHROPIC_API_KEY="your-anthropic-api-key"

# NextAuth (Admin Dashboard)
NEXTAUTH_SECRET="super-secret-nextauth-token-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Scraper & App Config
PORT=3000
NODE_ENV="development"
